# --- Database -----------------------------------------------------------------------------------
# Hostinger (no VPS): use Supabase. In the Supabase dashboard open Connect and copy:
#   DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=5
#   DIRECT_URL   = Session pooler (port 5432, host ...pooler.supabase.com). Used only for migrations.
# Do not use the "Direct connection" host (db.<ref>.supabase.co): it is IPv6-only on the free plan.
# Docker / local Postgres: point both at the same URL, and use the POSTGRES_* values below.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Only used by docker compose's bundled Postgres.
POSTGRES_USER=leadaudit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadaudit
# With docker compose, set these two to use Supabase instead of the bundled Postgres.
# EXTERNAL_DATABASE_URL=
# EXTERNAL_DIRECT_URL=

# --- Background jobs ------------------------------------------------------------------------------
# Audits run inside the web app: they start when created, continue while the progress page is open,
# and resume after a restart. A cron job calling /api/jobs/tick is the safety net for anything left
# behind. Set a long random value and use it in the Hostinger cron command (see DEPLOY-HOSTINGER.md).
JOBS_CRON_SECRET=

# --- Remote browser (Browserless) ----------------------------------------------------------------
# Website crawling, discovery and PDF export use Chromium on Browserless (browserless.io), so the host
# needs no browser. Leave BROWSERLESS_TOKEN blank to launch a local Chromium (Docker, local dev).
BROWSERLESS_TOKEN=
# Region endpoint: production-sfo (US West), production-lon (London) or production-ams (Amsterdam).
BROWSERLESS_URL=wss://production-sfo.browserless.io

# --- Application --------------------------------------------------------------------------------
# true uses synthetic fixtures and needs no keys. false switches collection to live and spends money.
# Website discovery always crawls for real, in either mode.
USE_MOCK_DATA=true
APP_PASSWORD=change-me
# The exact origin users open the app on. Used for origin checks and for PDF rendering. With
# Browserless the remote browser opens this URL, so it must be the public HTTPS address.
APP_ORIGIN=http://localhost:3000
AUDIT_CACHE_DAYS=7
# Host port the web container publishes on. Leave at 3000 unless it is already taken.
WEB_PORT=3000

# --- Collector credentials (server only, never prefix with NEXT_PUBLIC_) --------------------------
APIFY_TOKEN=
YOUTUBE_API_KEY=
# Apify actor IDs, configurable so a broken scraper can be swapped without code changes.
# Facebook and LinkedIn each need two actors: one for page/company metadata, one for posts.
APIFY_ACTOR_INSTAGRAM=hpix/instagram-scraper
APIFY_ACTOR_FACEBOOK=apify/facebook-pages-scraper
APIFY_ACTOR_FACEBOOK_POSTS=apify/facebook-posts-scraper
APIFY_ACTOR_LINKEDIN=automation-lab/linkedin-company-scraper
APIFY_ACTOR_LINKEDIN_POSTS=harvestapi/linkedin-company-posts
# Google Business Profile (Google Maps). About $0.009 per audit: one place + 10 reviews.
# Google search results for the SEO audit (indexed pages, brand ranking). Two SERP pages per audit.
APIFY_ACTOR_SERP=apify/google-search-scraper
APIFY_ACTOR_GBP=compass/crawler-google-places
# Reads a brand's homepage for the audience suggestion when discovery had no page text (optional; this is the default).
APIFY_ACTOR_SITE_TEXT=apify/rag-web-browser
# Optional ISO country code to bias Maps searches, e.g. in.
GBP_COUNTRY_CODE=in
# Website audit. PageSpeed Insights is free, but the keyless quota is shared and usually exhausted,
# so create a key in Google Cloud Console and enable "PageSpeed Insights API" for it.
PAGESPEED_API_KEY=
# AI for the plain-language summary and the audience-alignment analysis. Claude is used when an
# Anthropic key is set (console.anthropic.com); Gemini below is only a fallback. Each finished audit
# makes two requests: a summary and an alignment analysis of up to 120 posts (about $0.30-0.40 on
# Claude Opus 5 at list prices). Re-analysing from the report is one more request.
ANTHROPIC_KEY=
# Optional: pin a model. Default claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
# Fallback: AI plain-language summary of each report (Google Gemini). Blank = no summaries. Create a key at
# aistudio.google.com. One request per finished audit, plus one per "Regenerate" click.
GEMINI_API_KEY=
# Optional: pin a model. The default alias tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# --- Local development only -----------------------------------------------------------------------
# In Docker the Playwright base image provides browsers at /ms-playwright and sets this itself.
# Leave it unset in the container; set it only when running outside Docker.
# PLAYWRIGHT_BROWSERS_PATH=./.browsers
